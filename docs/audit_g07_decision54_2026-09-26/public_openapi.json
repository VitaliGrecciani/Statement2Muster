        ],
        "summary": "Get My Entitlements",
        "description": "Returns active plans, quota balance, and capabilities for the authenticated tenant (ADR-001).",
        "operationId": "get_my_entitlements_api_v1_me_entitlements_get",
        "responses": {
          "200": {
