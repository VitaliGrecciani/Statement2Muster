      "post": {
        "tags": [
          "billing"
        ],
        "summary": "Stripe Webhook",
        "description": "Signed Stripe Webhook endpoint (ADR-001 / Section 5).\nVerifies raw body signature, checks inbox idempotency, and transitions entitlements.",
