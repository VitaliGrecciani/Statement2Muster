  "components": {
    "schemas": {
      "Body_convert_statements_api_v1_convert_post": {
        "properties": {
          "files": {
            "items": {
              "type": "string",
              "format": "binary"
            },
            "type": "array",
            "title": "Files"
          }
        },
        "type": "object",
        "required": [
          "files"
        ],
        "title": "Body_convert_statements_api_v1_convert_post"
      },
      "FinancialSummary": {
        "properties": {
          "transaction_count": {
            "type": "integer",
            "title": "Transaction Count",
            "description": "Total number of processed bookings"
          },
          "total_debit": {
            "type": "number",
            "title": "Total Debit",
            "description": "Total sum of expenses/debits (negative or outgoing money)"
          },
          "total_credit": {
            "type": "number",
            "title": "Total Credit",
            "description": "Total sum of incomes/credits (incoming money)"
          },
          "net_balance": {
            "type": "number",
            "title": "Net Balance",
            "description": "Net balance turnover for the statement period"
          },
          "currency": {
            "type": "string",
            "title": "Currency",
            "description": "Primary currency",
            "default": "EUR"
          },
          "date_from": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date From",
            "description": "Earliest booking date in batch (YYYY-MM-DD)"
          },
          "date_to": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date To",
            "description": "Latest booking date in batch (YYYY-MM-DD)"
          }
        },
        "type": "object",
        "required": [
          "transaction_count",
          "total_debit",
          "total_credit",
          "net_balance"
        ],
        "title": "FinancialSummary"
      },
      "FreeTierStatus": {
        "properties": {
          "is_unlimited": {
            "type": "boolean",
            "title": "Is Unlimited",
            "description": "True if request is covered by active Pro/Starter/Lifetime entitlement",
            "default": false
          },
          "plan": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Plan",
            "description": "Active plan code (starter, pro, lifetime) if licensed"
          },
          "conversions_used": {
            "type": "integer",
            "title": "Conversions Used",
            "description": "Number of conversions used by this session/user",
            "default": 0
          },
          "remaining_free_conversions": {
            "type": "integer",
            "title": "Remaining Free Conversions",
            "description": "Remaining free conversions (0 if limit reached)",
            "default": 0
          },
          "max_free_conversions": {
            "type": "integer",
            "title": "Max Free Conversions",
            "description": "Maximum free conversions allowed without license",
            "default": 3
          },
          "limit_reached": {
            "type": "boolean",
            "title": "Limit Reached",
            "description": "True if free limit has been reached and upgrade is required",
            "default": false
          }
        },
        "type": "object",
        "title": "FreeTierStatus"
      },
      "GptConvertRequest": {
        "properties": {
          "request_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id",
            "description": "Optional unique client operation or idempotency ID",
            "example": "req-2026-03-10-001"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id",
            "description": "Optional ChatGPT conversation or session identifier to track demo usage",
            "example": "chatgpt-sess-88123"
          },
          "email": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ],
            "title": "Email",
            "description": "Optional user email. Note: Paid rights require authentication via Bearer token or signed token in license_key.",
            "example": "founder@startup.de"
          },
          "license_key": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4096
              },
              {
                "type": "null"
              }
            ],
            "title": "License Key",
            "description": "Optional signed JWT access token or API license token to activate paid entitlements without Authorization header",
            "example": "eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9..."
          },
          "bank_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Bank Name",
            "description": "Name of the financial institution or card provider (max 100 chars)",
            "default": "Bank Statement",
            "example": "American Express Business"
          },
          "export_format": {
            "type": "string",
            "enum": [
              "datev",
              "bmd",
              "muster_csv"
            ],
            "title": "Export Format",
            "description": "Target accounting export format: 'datev' (EXTF 700 Windows-1252), 'bmd' (NTCS 5.1), or 'muster_csv'",
            "default": "datev",
            "example": "datev"
          },
          "default_bank_account": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 20,
                "pattern": "^[0-9]{3,9}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Default Bank Account",
            "description": "Bank ledger account (3-9 digits, e.g. '1200' for SKR03, '1800' for SKR04, '2800' for BMD NTCS). Defaults to 1200 for DATEV and 2800 for BMD.",
            "example": "1200"
          },
          "transactions": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/GptTransactionItem"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Transactions",
            "description": "Array of structured transactions extracted by ChatGPT from the bank statement document."
          },
          "raw_content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Raw Content",
            "description": "Optional raw CSV or plaintext content of statement if transactions were not extracted into structured items."
          },
          "file_base64": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Base64",
            "description": "Optional base64-encoded PDF or CSV statement document to be processed by backend parser supervisor."
          },
          "filename": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Filename",
            "description": "Original statement filename hint (e.g. amex_march_2026.pdf).",
            "default": "statement.csv"
          }
        },
        "type": "object",
        "title": "GptConvertRequest"
      },
      "GptConvertResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success",
              "warning",
              "error",
              "limit_reached"
            ],
            "title": "Status",
            "default": "success"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Status message explaining outcome"
          },
          "export_format": {
            "type": "string",
            "title": "Export Format",
            "description": "Target export format produced"
          },
          "filename": {
            "type": "string",
            "title": "Filename",
            "description": "Generated export file name"
          },
          "download_id": {
            "type": "string",
            "title": "Download Id",
            "description": "Ephemeral token for downloading the file"
          },
          "download_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Download Url",
            "description": "Direct temporary URL to download the generated file"
          },
          "file_base64": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Base64",
            "description": "Base64-encoded CSV content for small files (omitted on large batches to respect ChatGPT 100k char limit)"
          },
          "expires_in_minutes": {
            "type": "integer",
            "title": "Expires In Minutes",
            "description": "Time until the download link expires (RAM-only retention)",
            "default": 30
          },
          "summary": {
            "allOf": [
              {
                "$ref": "#/components/schemas/FinancialSummary"
              }
            ],
            "description": "Financial turnover summary for accounting verification"
          },
          "preview_csv": {
            "type": "string",
            "title": "Preview Csv",
            "description": "First 5 lines preview of the generated DATEV/BMD file"
          },
          "free_tier_status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/FreeTierStatus"
              }
            ],
            "description": "Information on free tier usage and remaining balance"
          },
          "notes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Notes",
            "description": "Compliance and accounting notes"
          },
          "upgrade_info": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Upgrade Info",
