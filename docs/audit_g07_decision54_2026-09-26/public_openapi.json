    "/api/v1/convert": {
      "post": {
        "summary": "Convert Statements",
        "operationId": "convert_statements_api_v1_convert_post",
        "parameters": [
          {
            "name": "export_format",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "datev",
              "title": "Export Format"
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
