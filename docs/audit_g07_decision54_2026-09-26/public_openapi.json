              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Format"
            }
          },
          {
            "name": "default_bank_account",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "1200",
