{
  "manifest_version": 3,
  "name": "Statement2Muster DACH • DATEV & BMD Auszugskonverter",
  "version": "1.0.2",
  "description": "Kreditkarten- und Bankauszüge in Sekunden DATEV- & BMD-fertig konvertieren. 100% DSGVO-konform In-Memory.",
  "permissions": [
    "sidePanel",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://statement2muster.com/*",
    "https://www.statement2muster.com/*",
    "https://statement2-muster.vercel.app/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/pdf.worker.min.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Statement2Muster DACH öffnen",
    "default_icon": {
      "16": "icon_16.png",
      "48": "icon_48.png",
      "128": "icon_128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icon_16.png",
    "48": "icon_48.png",
    "128": "icon_128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "statement2muster@statement2muster.com",
      "strict_min_version": "109.0"
    }
  }
}
