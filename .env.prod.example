# Statement2Muster Production Environment Configuration (.env.prod)
ENVIRONMENT=production
PROJECT_NAME=Statement2Muster DACH
VERSION=1.0.2

# Database (In production container: persistent volume mount /app/data)
SQLITE_DB_PATH=/app/data/statement2muster_prod.db

# Asymmetric RS256 JWT Keys (Generated or preconfigured)
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=

# Website sign-in. Register the callback URL for each provider:
# https://api.statement2muster.com/api/v1/auth/oauth/{provider}/callback
OAUTH_SESSION_SECRET=replace_with_long_random_value
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Stripe Billing Configuration
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# SMTP Email Delivery (Mandatory in production)
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.eu.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@statement2muster.com
SMTP_PASSWORD=secret_smtp_password
SMTP_FROM=no-reply@statement2muster.com

# Parser Worker & Queue Budgets (Immutable process lifecycle)
PARSER_WORKER_CONCURRENCY=2
PARSER_MAX_QUEUE_DEPTH=4
PARSER_PROCESS_ISOLATION=true
PARSER_TIMEOUT_SECONDS=30
